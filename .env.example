VITE_DOCS_URL=http://localhost:3004
# Staging / VPS : VITE_DOCS_URL=https://docs.global-it-ss.com

APP_URL=http://localhost:8081

# Mailpit (Laragon) — UI http://127.0.0.1:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="InvoicePilot AI <noreply@invoicepilot.local>"
# Boîte qui reçoit les messages /contact (local = Mailpit)
MAIL_CONTACT_TO=contact@invoicepilot.local

# Production (exemple) :
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=...
# SMTP_PASS=...
# MAIL_FROM="InvoicePilot AI <noreply@invoicepilot.ai>"
# MAIL_CONTACT_TO=contact@invoicepilot.ai

# --- Analyse IA ---
# Local : heuristique par défaut (pas besoin de LLM).
# LLM_EXTRACT_ENABLED=true
# OPENAI_API_KEY=
# OPENAI_EXTRACT_MODEL=gpt-4o-mini
# Ou Ollama local :
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:3b

# Sandbox API : Bearer ip_sandbox_demo → http://localhost:8081/api/v1

# --- Stripe (test) ---
