# Copié vers /opt/invoicepilot/.env sur le VPS (ne pas committer les secrets)

POSTGRES_USER=invoicepilot
POSTGRES_PASSWORD=CHANGE_ME_PG_STRONG
POSTGRES_DB=invoicepilot_ai

MINIO_ROOT_USER=invoicepilot
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_MIN_16_CHARS
STORAGE_BUCKET=invoicepilot
STORAGE_BACKUP_BUCKET=invoicepilot-backups

APP_URL=https://app.global-it-ss.com
PUBLIC_URL=https://global-it-ss.com
DOCS_URL=https://docs.global-it-ss.com
VITE_DOCS_URL=https://docs.global-it-ss.com

# SMTP Hostinger (port 465 SSL)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=admin@gsms-security.com
SMTP_PASS=CHANGE_ME_SMTP
MAIL_FROM="InvoicePilot AI <admin@gsms-security.com>"
MAIL_CONTACT_TO=admin@gsms-security.com
AUTH_SHOW_2FA_CODE=false

# Chiffrement credentials PA (openssl rand -hex 32)
CREDENTIALS_SECRET=CHANGE_ME_HEX_32

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Webhook Stripe Dashboard → https://app.global-it-ss.com/api/stripe/webhook

# Analyse IA — Ollama dans docker-compose
LLM_EXTRACT_ENABLED=true
OLLAMA_BASE_URL=http://invoicepilot-ollama:11434
OLLAMA_MODEL=qwen2.5:3b
# OPENAI_API_KEY=
# OPENAI_EXTRACT_MODEL=gpt-4o-mini

# Backup Postgres → MinIO
BACKUP_INTERVAL_SEC=86400
BACKUP_RETENTION_DAYS=14

NODE_ENV=production
